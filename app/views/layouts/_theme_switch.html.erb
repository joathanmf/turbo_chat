<fieldset class="segmented" data-controller="theme" data-action="change->theme#pick">
  <legend class="sr-only">Aparência</legend>
  <% ApplicationHelper::THEMES.each do |value, label| %>
    <label title="<%= label %>">
      <input type="radio" name="theme" value="<%= value %>" class="sr-only" <%= "checked" if theme_preference == value %>>
      <% case value %>
      <% when "system" %>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
      <% when "light" %>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <% when "dark" %>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z"/></svg>
      <% end %>
      <span><%= label %></span>
    </label>
  <% end %>
</fieldset>
