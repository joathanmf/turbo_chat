<!DOCTYPE html>
<html lang="pt-BR" <%= tag.attributes(data: { theme: theme_preference }) if theme_preference != "system" %>>
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "Turbo Chat" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,interactive-widget=resizes-content">
    <meta name="description" content="Salas de conversa instantâneas. Sem cadastro, sem histórico: nada é gravado.">
    <meta name="color-scheme" content="light dark">
    <% if theme_preference == "system" %>
      <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)">
      <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)">
    <% else %>
      <meta name="theme-color" content="<%= theme_preference == "dark" ? "#000000" : "#f5f5f7" %>">
    <% end %>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render "layouts/flash" %>
    <%= yield %>
  </body>
</html>
